# ─── Production Environment Configuration Reference (Render + Vercel + Supabase) ───
# Copy these variables into your Render Service -> Environment Variables dashboard.
# Never commit real production secrets to Git.

PROJECT_NAME="MCT Companies Centralized Financial Management System"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
ENABLE_API_DOCS=false
HOST="0.0.0.0"
PORT=8000

# Strictly list your live Vercel frontend URL(s) and custom domain(s) (no wildcards, no localhost)
CORS_ORIGINS=["https://your-vercel-domain.vercel.app"]

# Public Frontend URL for user invitation magic links and password resets.
# CRITICAL: This MUST be the public HTTPS domain of your frontend (e.g. Vercel deployment or custom domain).
# Do NOT set this to localhost or your backend Render URL.
# The user's email will receive links directing them to:
#   https://<FRONTEND_URL>/auth/setup-password#token=<token>
# If omitted, the backend will automatically default to the primary https:// origin listed in CORS_ORIGINS.
FRONTEND_URL="https://your-vercel-domain.vercel.app"

# Secure cookies enforced automatically in production (HTTPS-only)
OTP_COOKIE_SECURE=true

# Supabase PostgreSQL & Auth Configuration
# Note: Use port 6543 (Supabase Transaction Pooler) in production.
# Ensure Daily Backups and Point-in-Time Recovery (PITR) are enabled in Supabase -> Database -> Backups.
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_KEY="<your-supabase-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<your-supabase-service-role-key>"
DATABASE_URL="postgresql://postgres.<your-project-ref>:<your-db-password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres"

# Security & Encryption Secrets (minimum 32 characters for JWT/HMAC)
SUPABASE_JWT_SECRET="<your-supabase-jwt-secret-min-32-chars>"
OTP_HMAC_SECRET="<your-otp-hmac-secret-min-32-chars>"
PAYLOAD_ENCRYPTION_KEY="<your-fernet-base64-key>"

# Brevo Transactional Email & Built-in 500 Crash Alerting
# Note: Primary admin recipient is automatically resolved from Supabase `is_admin = true` and cached in memory.
# Set ADMIN_EMAIL below to an operational alerts inbox as a safety net for cold-start total database outages.
BREVO_API_KEY="<your-brevo-api-key>"
BREVO_FROM_EMAIL="<verified-sender@yourdomain.com>"
BREVO_FROM_NAME="MCT Financial System"
ADMIN_EMAIL="<admin-alerts@yourdomain.com>"

