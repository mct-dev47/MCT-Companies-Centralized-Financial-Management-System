# ─── Development/Staging Environment Configuration Reference (Render + Vercel) ───
# Copy these variables into your Development Render Service (e.g. mct-companies-centralized-financial-lwnr) -> Environment Variables dashboard.

PROJECT_NAME="MCT Companies Centralized Financial Management System (Dev)"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
ENABLE_API_DOCS=true
HOST="0.0.0.0"
PORT=8000

# Strictly list your Development Vercel frontend URL(s) and local dev
CORS_ORIGINS=["https://mct-companies-centralized-financial-swart.vercel.app", "http://localhost:5173", "http://127.0.0.1:5173"]

# Public Frontend URL for user invitation magic links and password resets on Dev
FRONTEND_URL="https://mct-companies-centralized-financial-swart.vercel.app"

# Enforce secure cookies for HTTPS deployments on Vercel
OTP_COOKIE_SECURE=true

# Supabase PostgreSQL & Auth Configuration (Use your DEV Supabase Project / Database)
SUPABASE_URL="https://<your-dev-project-ref>.supabase.co"
SUPABASE_KEY="<your-dev-supabase-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<your-dev-supabase-service-role-key>"
DATABASE_URL="postgresql://postgres.<your-dev-project-ref>:<your-db-password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres"

# Security & Encryption Secrets (minimum 32 characters for JWT/HMAC)
# IMPORTANT: PAYLOAD_ENCRYPTION_KEY must match VITE_PAYLOAD_ENCRYPTION_KEY on your Vercel dev deployment
SUPABASE_JWT_SECRET="<your-dev-supabase-jwt-secret-min-32-chars>"
OTP_HMAC_SECRET="<your-dev-otp-hmac-secret-min-32-chars>"
PAYLOAD_ENCRYPTION_KEY="PFwXknJWMQbwwl8XKG1YfIFQdg6ByesKxPWLzN88ecA="

# Brevo Transactional Email Configuration
BREVO_API_KEY="<your-brevo-api-key>"
BREVO_FROM_EMAIL="<verified-sender@yourdomain.com>"
BREVO_FROM_NAME="MCT Financial System (Dev)"
ADMIN_EMAIL="<admin-alerts@yourdomain.com>"
