PROJECT_NAME="MCT Companies Centralized Financial Management System"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:5174", "http://127.0.0.1:5174"]
# Frontend application URL (used to generate invitation magic links and password reset links)
# For local dev: http://localhost:5173
# For LAN access: http://<LAN_IP>:5173
# For production: https://your-vercel-domain.vercel.app
FRONTEND_URL="http://localhost:5173"
HOST="127.0.0.1"
PORT=8000

# Supabase API Configuration
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Supabase PostgreSQL Direct Database Connection (Optional for SQLAlchemy ORM)
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres"

# Brevo (formerly Sendinblue) Transactional Email Configuration
# API key from Brevo dashboard (SMTP & API -> API Keys)
BREVO_API_KEY="xkeysib-your-brevo-api-key"
# Sender email MUST be a verified sender in your Brevo account (Senders & IP -> Senders)
BREVO_FROM_EMAIL="your-verified-sender@example.com"
BREVO_FROM_NAME="MCT Financial System"
OTP_COOKIE_SECURE=false
